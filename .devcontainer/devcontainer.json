{
  "name": "intern-day-2-frontend",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "node",
  "forwardPorts": [5173],
  "postCreateCommand": "pnpm install --frozen-lockfile --config.confirmModulesPurge=false"
}
