# 浏览器访问后端使用的地址（不是容器内部的 localhost）
VITE_API_BASE_URL=http://localhost:8000

# 浏览器访问 CopilotKit Runtime 的地址。留空即可：
# 前端默认用同源的 /api/copilotkit，由 vite.config.ts 代理到 Runtime，
# 不依赖宿主机的 4000 端口（被别的容器占用时 VS Code 会把它自动转发成 4001）。
# 只有 Runtime 部署在独立域名下才需要填绝对地址，例如：
# VITE_COPILOT_RUNTIME_URL=http://localhost:4000/api/copilotkit

# 以下是给构建/服务进程用的，VITE_ 前缀的才会进浏览器产物，
# 所以这些变量不会暴露给前端
# Vite 代理的目标。Dev Containers 里 Runtime 同容器，用默认值；
# Docker Compose 里由 compose.yaml 注入 http://runtime:4000
RUNTIME_PROXY_TARGET=http://localhost:4000
AGENT_URL=http://host.docker.internal:8000/agent
AGENT_ID=todo-agent
PORT=4000
RUNTIME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上游 Agent 多少毫秒没有任何输出就主动结束本次运行（写一条 RUN_ERROR 再断开）。
# 后端被杀时本来就立刻报错；这个值兜的是"连接能建但不回数据"的假死情况，
# 没有它页面会一直停在"发送中"。演示想快点看到效果可以临时调小。
STREAM_IDLE_TIMEOUT_MS=20000

COPILOTKIT_TELEMETRY_DISABLED=true
