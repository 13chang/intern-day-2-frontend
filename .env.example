# 浏览器访问后端使用的地址（不是容器内部的 localhost）
VITE_API_BASE_URL=http://localhost:8000

# 浏览器访问 CopilotKit Runtime 的地址（第三天新增）
VITE_COPILOT_RUNTIME_URL=http://localhost:4000/api/copilotkit

# 以下是给 Runtime 进程（server/index.mjs）用的，VITE_ 前缀的才会进浏览器产物，
# 所以这些变量不会暴露给前端
AGENT_URL=http://host.docker.internal:8000/agent
AGENT_ID=todo-agent
PORT=4000
RUNTIME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COPILOTKIT_TELEMETRY_DISABLED=true
